<section class="system-shell rank-{{system.rank}} combat-shell"><div class="system-panel"><h2>{{actor.name}} — {{titlecase system.rank}}</h2><h3>Action Score: {{score}}</h3><p>Life Force: {{system.resources.lifeForce.value}}/{{system.resources.lifeForce.max}}</p><p>Mana: {{system.resources.mana.value}}/{{system.resources.mana.max}}</p><p>Stamina: {{system.resources.stamina.value}}/{{system.resources.stamina.max}}</p><p>Normal Shield: {{system.resources.shield.value}} | Armor: {{system.resources.armor.value}}</p><button type="button" data-cost="2">Move (2)</button><h3>Favorite Abilities</h3>{{#each abilities as |a|}}<div class="list-row">{{a.name}} <button type="button" data-cost="{{a.system.actionCost}}">Spend {{a.system.actionCost}} AP</button></div>{{else}}<p>Mark abilities as favorites to display them here.</p>{{/each}}</div></section>