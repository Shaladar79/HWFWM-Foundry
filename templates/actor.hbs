<form class="system-shell rank-{{rank}}" autocomplete="off">
<header class="system-header"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="portrait"/>
<div class="system-identity"><h1><input name="name" value="{{actor.name}}"/></h1><div>{{titlecase actor.type}} · {{titlecase rank}} Rank</div>{{#if isEssenceUser}}<span>Nature: {{system.nature}}</span><label>Role <input name="system.role" value="{{system.role}}"/></label>{{/if}}</div><button type="button" data-action="combat">Combat Panel</button></header>
<section class="resource-grid">{{#each system.resources as |resource key|}}{{#unless (eq key "manaShield")}}<div class="system-panel resource"><strong>{{titlecase key}}</strong><div><input type="number" name="system.resources.{{key}}.value" value="{{resource.value}}"/> / <span>{{resource.max}}</span></div></div>{{/unless}}{{/each}}</section>
<nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="overview">Overview</a><a class="item" data-tab="abilities">Abilities</a><a class="item" data-tab="skills">Skills</a><a class="item" data-tab="talents">Talents</a><a class="item" data-tab="equipment">Equipment</a><a class="item" data-tab="progression">Progression</a><a class="item" data-tab="biography">Biography</a></nav>
<section class="sheet-body">
<div class="tab" data-group="primary" data-tab="overview"><div class="system-panel"><h2>Character Profile</h2><label>Nature <select data-action="select-nature"><option value="">Choose a standard Nature</option>{{#each natureChoices as |n|}}<option value="{{n.name}}" {{#if n.selected}}selected{{/if}}>{{n.name}}</option>{{/each}}</select></label><p>Outworlder and custom Natures remain GM-only and deferred.</p><label>Role <input data-profile="role" value="{{system.role}}" placeholder="Adventuring Role"/></label><button type="button" data-action="save-profile">Save Profile</button>{{#unless hasIdentity}}<p>Complete Nature and Role before beginning guided essence setup.</p>{{/unless}}</div>{{#if isGM}}<div class="system-panel"><h3>GM Nature Story Events</h3><p>Evolution records require a significant story event; new mechanical effects remain subject to separate GM review.</p><label>Gift Slot <select data-nature-event="slot">{{#each natureGifts as |g|}}<option value="{{g.slot}}">{{g.slot}} — {{g.name}}</option>{{/each}}</select></label><label>Evolution Description <input data-nature-event="description" placeholder="Approved narrative evolution"/></label><label>Significant Story Event <textarea data-nature-event="reason" placeholder="Document the exceptional story event"></textarea></label><button type="button" data-action="approve-nature-evolution">Record GM Evolution</button><label>Transform Into <select data-nature-event="next"><option value="">Choose Nature</option>{{#each natureChoices as |n|}}<option value="{{n.name}}">{{n.name}}</option>{{/each}}</select></label><button type="button" data-action="approve-nature-transformation">Approve Exceptional Transformation</button><h4>Nature Event History</h4>{{#each natureHistory as |event|}}<p>{{event.kind}} — {{event.reason}} ({{event.at}})</p>{{else}}<p>No GM-approved events recorded.</p>{{/each}}</div>{{/if}}<div class="system-panel"><h2>Nature Gifts</h2>{{#each natureGifts as |g|}}<p><strong>{{g.slot}}. {{g.name}}</strong> — {{g.effect}}{{#if g.workInProgress}} (WIP){{else}} ({{g.bonus}}){{/if}}</p>{{else}}<p>Select a Nature to see its six gifts.</p>{{/each}}</div><div class="system-panel"><h2>Attributes</h2><div class="attribute-grid">{{#each attributes as |a|}}<div class="system-panel"><strong>{{titlecase a.key}}</strong><p>{{titlecase a.rank}} {{a.level}} · {{a.tn}}%</p><p>{{a.essence}}</p><button type="button" data-action="roll" data-attribute="{{a.key}}">Roll d100</button></div>{{/each}}</div></div>{{#if isGM}}<div class="system-panel"><h3>GM Resource Recovery</h3><label>Resource <select data-recovery-field="resource"><option value="lifeForce">Life Force</option><option value="mana">Mana</option><option value="stamina">Stamina</option></select></label><label>Amount <input type="number" min="0" step="1" data-recovery-field="amount" value="0"/></label><button type="button" data-action="gm-recover-resource">Restore Resource</button><p>Recovery cannot exceed the resource maximum; regeneration rates are not yet defined.</p></div><div class="system-panel"><h3>GM Apply Damage to This Actor</h3><label>Damage <input type="number" min="0" step="1" data-hit-field="amount"/></label><label>Unique Hit ID <input data-hit-field="id" placeholder="e.g. encounter3-hit7"/></label><label>Subtype <input data-hit-field="subtype" placeholder="fire"/></label><label>Physical <input type="checkbox" data-hit-field="physical"/></label><button type="button" data-action="apply-nature-hit">Apply Damage Once</button><p>Use a new Hit ID for each attack. Duplicate IDs for this actor are rejected.</p></div>{{/if}}{{#if isRunic}}<div class="system-panel"><h3>Adaptive Resistance</h3><p>Active element: {{adaptiveSubtype}} (5% against subsequent matching hits)</p>{{#if isGM}}<button type="button" data-action="reset-adaptive">End Encounter — Clear Resistance</button>{{/if}}</div>{{/if}}<div class="system-panel"><h2>Combat</h2><p>Movement: {{system.movement}}</p><button type="button" data-action="rank-roll" data-type="hostile">Hostile Power Roll</button><button type="button" data-action="physical-attack">Physical Attack (Targeted, Nature Defense)</button><button type="button" data-action="rank-roll" data-type="beneficial">Beneficial Power Roll</button></div></div>
<div class="tab" data-group="primary" data-tab="abilities"><div class="system-panel"><h2>Essence Abilities</h2><datalist id="hwfwm-stone-list">{{#each awakeningStones as |stone|}}<option value="{{stone.name}}" label="{{stone.rarity}}"></option>{{/each}}</datalist>{{#if isGM}}<details class="system-panel"><summary>Add Custom Awakening Stone</summary><label>Name <input data-stone-field="name"/></label><label>Rarity <select data-stone-field="rarity"><option value="common">Common</option><option value="uncommon">Uncommon</option><option value="rare">Rare</option><option value="epic">Epic</option><option value="legendary">Legendary</option><option value="unknown">Unknown</option></select></label><label>Notes <input data-stone-field="description"/></label><button type="button" data-action="add-custom-stone">Add to World Catalog</button></details>{{/if}}{{#if isEssenceUser}}{{#unless hasEssences}}<div class="system-panel"><h3>Guided Essence Setup</h3><p>Choose three primary essences from the catalog (or enter a GM-approved custom name) and one GM-approved confluence. Every essence must bond to a different attribute.</p>
<datalist id="hwfwm-essence-list">{{#each catalogEssences as |e|}}<option value="{{e.name}}" label="{{e.label}}"></option>{{/each}}</datalist><label>First Essence <input list="hwfwm-essence-list" data-setup="first" placeholder="Primary essence"/></label><label>Attribute <select data-setup="firstAttribute"><option value="power">Power</option><option value="speed">Speed</option><option value="spirit">Spirit</option><option value="recovery">Recovery</option></select></label>
<label>Second Essence <input list="hwfwm-essence-list" data-setup="second" placeholder="Primary essence"/></label><label>Attribute <select data-setup="secondAttribute"><option value="speed">Speed</option><option value="power">Power</option><option value="spirit">Spirit</option><option value="recovery">Recovery</option></select></label>
<label>Third Essence <input list="hwfwm-essence-list" data-setup="third" placeholder="Primary essence"/></label><label>Attribute <select data-setup="thirdAttribute"><option value="spirit">Spirit</option><option value="power">Power</option><option value="speed">Speed</option><option value="recovery">Recovery</option></select></label>
<button type="button" data-action="suggest-confluences">Refresh Confluence Choices</button><label>Known Confluence <select data-setup="confluenceChoice"><option value="custom">Custom / GM-approved</option></select></label><p data-confluence-feedback>No documented match loaded. Select primary essences, then refresh choices.</p><label>Custom Confluence <input data-setup="confluence" placeholder="GM-approved name"/></label><label>Attribute <select data-setup="confluenceAttribute"><option value="recovery">Recovery</option><option value="power">Power</option><option value="speed">Speed</option><option value="spirit">Spirit</option></select></label>
<button type="button" data-action="create-character-essences">Create Essences and 20 Ability Slots</button>{{#if isGM}}<div class="system-panel"><h3>Add a Custom Essence</h3><label>Name <input data-catalog-field="name"/></label><label>Rarity <select data-catalog-field="rarity"><option value="common">Common</option><option value="uncommon">Uncommon</option><option value="rare">Rare</option><option value="epic">Epic</option><option value="legendary">Legendary</option><option value="unknown">Unknown</option></select></label><label>Description <input data-catalog-field="description"/></label><button type="button" data-action="add-custom-essence">Add to World Catalog</button></div>{{/if}}</div>{{/unless}}{{#each essenceGroups as |g|}}<div class="system-panel"><h3>{{titlecase g.key}} — {{g.essenceName}}</h3>{{#if g.essenceId}}<label>Bond <select data-action="bond-essence" data-id="{{g.essenceId}}">{{#each g.bondOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{titlecase o.label}}</option>{{/each}}</select></label><label>Essence name <input data-action="rename-essence" data-id="{{g.essenceId}}" value="{{g.essenceName}}"/></label>{{/if}}{{#each g.abilities as |a|}}<div class="system-panel" data-editor-id="{{a.id}}"><div class="list-row"><label>Name <input data-edit-field="name" value="{{a.name}}"/></label><strong>{{titlecase a.rank}} {{a.level}}</strong></div><label>Action Cost <input type="number" min="0" data-edit-field="actionCost" value="{{a.actionCost}}"/></label><label>Mana Cost <input type="number" min="0" data-edit-field="manaCost" value="{{a.manaCost}}"/></label><label>Stamina Cost <input type="number" min="0" data-edit-field="staminaCost" value="{{a.staminaCost}}"/></label><label>Awakening Stone <input data-edit-field="awakeningStone" list="hwfwm-stone-list" value="{{a.awakeningStone}}" placeholder="Select or GM-approved custom"/></label><label>Favorite <input type="checkbox" data-edit-field="favorite" {{#if a.favorite}}checked{{/if}}/></label>{{#if a.apConfigured}}<p>Ability AP allocated: {{a.apSpent}} ({{a.abilityType}}). Further upgrade spending is not yet available.</p>{{else}}{{#if @root.apEnabled}}<label>Ability Category <select data-ap-field="type">{{#each a.apTypes as |t|}}<option value="{{t.value}}" {{#if t.selected}}selected{{/if}}>{{t.value}}</option>{{/each}}</select></label><label>Ability purpose <select data-ap-field="purpose"><option value="standard">Standard</option><option value="summon">Summoning</option><option value="familiar">Familiar</option></select></label><label>AP to allocate (base {{@root.baseAPBudget}}, matching Nature bonus +2) <input data-ap-field="spent" type="number" min="0" step="1" value="0"/></label><button type="button" data-action="allocate-ability-ap" data-id="{{a.id}}">Allocate Creation AP</button>{{else}}<p>AP allocation is disabled until GM configures a base AP budget.</p>{{/if}}{{/if}}<label>Ability Design Notes <textarea data-edit-field="blueprintNotes" placeholder="Essence influence, Awakening Stone influence and future component details">{{a.blueprintNotes}}</textarea></label><details><summary>P4 Essence Ability Components ({{a.blueprintComponents}})</summary>
{{#each a.componentRows as |c|}}<div class="list-row"><strong>{{c.kind}}</strong> {{c.label}} — {{c.source}}{{#if c.apCost}} · {{c.apCost}} AP{{/if}} {{c.configuration.scalingMode}} <button type="button" data-action="p4-remove-component" data-id="{{a.id}}" data-index="{{c.index}}">Remove</button></div>{{else}}<p>No components designed yet.</p>{{/each}}
<label>Effect <select data-p4-field="kind">{{#each @root.p4ComponentKinds as |k|}}<option value="{{k}}">{{k}}</option>{{/each}}</select></label>
<label>Source <select data-p4-field="source">{{#each @root.p4ComponentSources as |src|}}<option value="{{src}}">{{src}}</option>{{/each}}</select></label>
<label>Label <input data-p4-field="label" placeholder="Description of effect"/></label>
<label>AP price (blank = undecided) <input type="number" min="0" step="1" data-p4-field="apCost" placeholder="Not set"/></label>
<label>Scaling <select data-p4-field="scaling"><option value="none">No scaling defined</option><option value="per-success">Per success (design intent)</option></select></label>
<label>Component notes <textarea data-p4-field="notes"></textarea></label>
<button type="button" data-action="p4-add-component" data-id="{{a.id}}">Add Component</button>
<p>Component pricing and effect calculations are not automatic. AP totals do not spend AP.</p></details><button type="button" data-action="save-ability" data-id="{{a.id}}">Save Ability</button>{{#if @root.apEnabled}}{{#if a.apConfigured}}<label>Upgrade AP to spend (base {{@root.baseAPBudget}}, plus eligible Nature aptitude)<input type="number" min="0" step="1" data-ap-field="upgrade" value="0"/></label><p>Previous upgrade AP transactions: {{a.apHistory.length}}</p>{{/if}}{{/if}}<button type="button" data-action="advance-ability" data-id="{{a.id}}">Advance ({{a.cost}} XP)</button></div>{{else}}<p>No linked abilities; each bonded essence needs five.</p>{{/each}}</div>{{/each}}{{else}}<p>Non-essence actor. Monster and familiar abilities are developed separately.</p>{{/if}}</div></div>
<div class="tab" data-group="primary" data-tab="skills"><div class="system-panel"><h2>Skills</h2>{{#if startingSkillsChosen}}{{#if skillTalentCost}}<div class="system-panel"><h3>Learn Another Skill Talent</h3><label>Talent <select data-purchase-skill><option value="">Choose another skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><button type="button" data-action="buy-skill-talent">Purchase ({{skillTalentCost}} Talent XP)</button></div>{{/if}}{{/if}}{{#unless startingSkillsChosen}}<div class="system-panel"><h3>Choose Five Starting Skill Talents</h3><p>Five distinct skills. Ritual Knowledge requires Magic Theory. Specializations are acquired later.</p><label>Choice 1<select data-starting-skill><option value="">Choose skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><label>Choice 2<select data-starting-skill><option value="">Choose skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><label>Choice 3<select data-starting-skill><option value="">Choose skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><label>Choice 4<select data-starting-skill><option value="">Choose skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><label>Choice 5<select data-starting-skill><option value="">Choose skill</option>{{#each startingSkillOptions as |skill|}}<option value="{{skill.name}}">{{skill.attribute}} — {{skill.name}}</option>{{/each}}</select></label><button type="button" data-action="grant-starting-skills">Grant Five Skill Talents</button></div>{{/unless}}<div class="system-panel"><h3>Attribute Saving Throws</h3>{{#each savingThrowOptions as |save|}}<button type="button" data-action="roll-save" data-attribute="{{save.attribute}}">{{save.name}}</button>{{/each}}</div>{{#each skillItems as |s|}}<div class="list-row">{{s.name}} ({{s.system.attribute}}{{#if s.system.trained}}, trained{{/if}}{{#if s.system.specialization}}, specialized{{/if}}) <button type="button" data-action="roll-skill" data-id="{{s.id}}">Roll Skill</button>{{#unless s.system.specialization}}{{#if @root.specializationCost}}<button type="button" data-action="buy-specialization" data-id="{{s.id}}">Specialize ({{@root.specializationCost}} Talent XP)</button>{{/if}}{{/unless}}</div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="talents"><div class="system-panel"><h2>Talents</h2><p>Talent XP: {{system.talentXP}}</p><div class="system-panel"><h3>Evasive Footwork</h3><p>Ranks: {{evasiveTalent.ranks}} / {{evasiveTalent.maximum}} ({{evasiveTalent.physicalAttackTNModifier}}% to incoming physical attack TN)</p><p>Purchase cost: {{evasiveCost}} Talent XP (zero means not configured)</p>{{#if canPurchaseEvasive}}<button type="button" data-action="buy-evasive">Purchase Evasive Footwork Rank</button>{{/if}}</div>{{#each talentItems as |t|}}<p>{{t.name}}</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="equipment"><div class="system-panel"><h2>Equipment</h2>{{#each equipmentItems as |it|}}<div class="list-row">{{it.name}} — {{it.system.slot}}</div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="progression"><div class="system-panel"><h2>Advancement</h2><label>Essence XP <input type="number" name="system.essenceXP" value="{{system.essenceXP}}"/></label><label>Talent XP <input type="number" name="system.talentXP" value="{{system.talentXP}}"/></label>{{#if isGM}}<div class="system-panel"><h3>GM XP Awards</h3><label>Amount <input data-award-amount type="number" min="1" value="5"/></label><label>Reason <input data-award-reason value="Story milestone"/></label><button type="button" data-action="award-xp" data-currency="essenceXP">Award Essence XP</button><button type="button" data-action="award-xp" data-currency="talentXP">Award Talent XP</button></div>{{/if}}<div class="system-panel"><h3>Advancement Ledger</h3>{{#each ledger as |event|}}<p>{{event.kind}}: {{event.currency}} {{event.amount}} {{event.reason}} {{event.from}} {{event.to}} {{event.rankFrom}} {{event.rankTo}}</p>{{else}}<p>No advancement transactions recorded.</p>{{/each}}</div><div class="system-panel"><h3>Recent Awards</h3>{{#each recentXP as |entry|}}<p>{{entry.currency}} +{{entry.amount}} — {{entry.reason}}</p>{{else}}<p>No awards recorded.</p>{{/each}}</div><p>Rank is determined by the lowest of your four attributes; each attribute follows the lowest of its five essence abilities.</p>{{#each attributes as |a|}}<p>{{titlecase a.key}} — {{titlecase a.rank}} {{a.level}}</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="biography"><div class="system-panel"><h2>Biography</h2></div></div>
</section></form>