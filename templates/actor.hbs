<form class="system-shell rank-{{rank}}" autocomplete="off">
<header class="system-header"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="portrait"/>
<div class="system-identity"><h1><input name="name" value="{{actor.name}}"/></h1><div>{{titlecase actor.type}} · {{titlecase rank}} Rank</div>{{#if isEssenceUser}}<label>Nature <input name="system.nature" value="{{system.nature}}"/></label><label>Role <input name="system.role" value="{{system.role}}"/></label>{{/if}}</div><button type="button" data-action="combat"><i class="fas fa-shield-alt"></i> Combat</button></header>
<section class="resource-grid">
{{#each system.resources as |resource key|}}{{#unless (eq key "manaShield")}}<div class="system-panel resource"><strong>{{titlecase key}}</strong><div><input type="number" name="system.resources.{{key}}.value" value="{{resource.value}}"/> / <span>{{resource.max}}</span></div></div>{{/unless}}{{/each}}
</section>
<nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="overview">Overview</a><a class="item" data-tab="abilities">Abilities</a><a class="item" data-tab="skills">Skills</a><a class="item" data-tab="talents">Talents</a><a class="item" data-tab="equipment">Equipment</a><a class="item" data-tab="progression">Progression</a><a class="item" data-tab="biography">Biography</a></nav>
<section class="sheet-body">
<div class="tab" data-group="primary" data-tab="overview"><div class="system-panel"><h2>Attributes</h2><div class="attribute-grid">{{#each attributes as |a|}}<div class="system-panel"><strong>{{titlecase a.key}}</strong><p>{{titlecase a.rank}} {{a.level}} · {{a.tn}}%</p><p>{{a.essence}}</p><button type="button" data-action="roll" data-attribute="{{a.key}}">Roll d100</button></div>{{/each}}</div></div><div class="system-panel"><h2>Combat</h2><p>Movement: {{system.movement}} · Normal Shield → Mana Shield → Armor → Extra Life Force → Life Force</p><button type="button" data-action="rank-roll" data-type="hostile">Hostile Power Roll</button><button type="button" data-action="rank-roll" data-type="beneficial">Beneficial Power Roll</button></div></div>
<div class="tab" data-group="primary" data-tab="abilities"><div class="system-panel"><h2>Essence Abilities</h2>{{#each abilityItems as |a|}}<div class="list-row"><strong>{{a.name}}</strong><span>{{titlecase a.system.rank}} {{a.system.level}} · Cost {{a.system.actionCost}}</span></div>{{else}}<p>Create Ability items and associate them with Essence items to calculate attribute advancement.</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="skills"><div class="system-panel"><h2>Skills</h2>{{#each skillItems as |s|}}<div class="list-row">{{s.name}} <span>+{{#if s.system.trained}}5{{else}}0{{/if}}% trained</span></div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="talents"><div class="system-panel"><h2>Talents</h2><p>Talent XP: <input type="number" name="system.talentXP" value="{{system.talentXP}}"/></p>{{#each talentItems as |t|}}<p>{{t.name}}</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="equipment"><div class="system-panel"><h2>Equipment</h2>{{#each equipmentItems as |it|}}<div class="list-row">{{it.name}} <span>{{it.system.slot}}</span></div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="progression"><div class="system-panel"><h2>Advancement</h2><label>Essence XP <input type="number" name="system.essenceXP" value="{{system.essenceXP}}"/></label><label>Talent XP <input type="number" name="system.talentXP" value="{{system.talentXP}}"/></label><p>Each attribute takes the lowest of its five linked essence abilities. Overall rank is the lowest attribute rank.</p></div></div>
<div class="tab" data-group="primary" data-tab="biography"><div class="system-panel"><h2>Biography</h2><p>Character narrative and relationship tools are planned for a later milestone.</p></div></div>
</section></form>