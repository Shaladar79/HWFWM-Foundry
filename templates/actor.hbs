<form class="system-shell rank-{{rank}}" autocomplete="off">
<header class="system-header"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="portrait"/>
<div class="system-identity"><h1><input name="name" value="{{actor.name}}"/></h1><div>{{titlecase actor.type}} · {{titlecase rank}} Rank</div>{{#if isEssenceUser}}<label>Nature <input name="system.nature" value="{{system.nature}}"/></label><label>Role <input name="system.role" value="{{system.role}}"/></label>{{/if}}</div><button type="button" data-action="combat">Combat Panel</button></header>
<section class="resource-grid">{{#each system.resources as |resource key|}}{{#unless (eq key "manaShield")}}<div class="system-panel resource"><strong>{{titlecase key}}</strong><div><input type="number" name="system.resources.{{key}}.value" value="{{resource.value}}"/> / <span>{{resource.max}}</span></div></div>{{/unless}}{{/each}}</section>
<nav class="sheet-tabs tabs" data-group="primary"><a class="item" data-tab="overview">Overview</a><a class="item" data-tab="abilities">Abilities</a><a class="item" data-tab="skills">Skills</a><a class="item" data-tab="talents">Talents</a><a class="item" data-tab="equipment">Equipment</a><a class="item" data-tab="progression">Progression</a><a class="item" data-tab="biography">Biography</a></nav>
<section class="sheet-body">
<div class="tab" data-group="primary" data-tab="overview"><div class="system-panel"><h2>Character Profile</h2><label>Nature <input data-profile="nature" value="{{system.nature}}" placeholder="Character Nature"/></label><label>Role <input data-profile="role" value="{{system.role}}" placeholder="Adventuring Role"/></label><button type="button" data-action="save-profile">Save Profile</button>{{#unless hasIdentity}}<p>Complete Nature and Role before beginning guided essence setup.</p>{{/unless}}</div><div class="system-panel"><h2>Attributes</h2><div class="attribute-grid">{{#each attributes as |a|}}<div class="system-panel"><strong>{{titlecase a.key}}</strong><p>{{titlecase a.rank}} {{a.level}} · {{a.tn}}%</p><p>{{a.essence}}</p><button type="button" data-action="roll" data-attribute="{{a.key}}">Roll d100</button></div>{{/each}}</div></div><div class="system-panel"><h2>Combat</h2><p>Movement: {{system.movement}}</p><button type="button" data-action="rank-roll" data-type="hostile">Hostile Power Roll</button><button type="button" data-action="rank-roll" data-type="beneficial">Beneficial Power Roll</button></div></div>
<div class="tab" data-group="primary" data-tab="abilities"><div class="system-panel"><h2>Essence Abilities</h2><datalist id="hwfwm-stone-list">{{#each awakeningStones as |stone|}}<option value="{{stone.name}}" label="{{stone.rarity}}"></option>{{/each}}</datalist>{{#if isGM}}<details class="system-panel"><summary>Add Custom Awakening Stone</summary><label>Name <input data-stone-field="name"/></label><label>Rarity <select data-stone-field="rarity"><option value="common">Common</option><option value="uncommon">Uncommon</option><option value="rare">Rare</option><option value="epic">Epic</option><option value="legendary">Legendary</option><option value="unknown">Unknown</option></select></label><label>Notes <input data-stone-field="description"/></label><button type="button" data-action="add-custom-stone">Add to World Catalog</button></details>{{/if}}{{#if isEssenceUser}}{{#unless hasEssences}}<div class="system-panel"><h3>Guided Essence Setup</h3><p>Choose three primary essences from the catalog (or enter a GM-approved custom name) and one GM-approved confluence. Every essence must bond to a different attribute.</p>
<datalist id="hwfwm-essence-list">{{#each catalogEssences as |e|}}<option value="{{e.name}}" label="{{e.label}}"></option>{{/each}}</datalist><label>First Essence <input list="hwfwm-essence-list" data-setup="first" placeholder="Primary essence"/></label><label>Attribute <select data-setup="firstAttribute"><option value="power">Power</option><option value="speed">Speed</option><option value="spirit">Spirit</option><option value="recovery">Recovery</option></select></label>
<label>Second Essence <input list="hwfwm-essence-list" data-setup="second" placeholder="Primary essence"/></label><label>Attribute <select data-setup="secondAttribute"><option value="speed">Speed</option><option value="power">Power</option><option value="spirit">Spirit</option><option value="recovery">Recovery</option></select></label>
<label>Third Essence <input list="hwfwm-essence-list" data-setup="third" placeholder="Primary essence"/></label><label>Attribute <select data-setup="thirdAttribute"><option value="spirit">Spirit</option><option value="power">Power</option><option value="speed">Speed</option><option value="recovery">Recovery</option></select></label>
<button type="button" data-action="suggest-confluences">Refresh Confluence Choices</button><label>Known Confluence <select data-setup="confluenceChoice"><option value="custom">Custom / GM-approved</option></select></label><p data-confluence-feedback>No documented match loaded. Select primary essences, then refresh choices.</p><label>Custom Confluence <input data-setup="confluence" placeholder="GM-approved name"/></label><label>Attribute <select data-setup="confluenceAttribute"><option value="recovery">Recovery</option><option value="power">Power</option><option value="speed">Speed</option><option value="spirit">Spirit</option></select></label>
<button type="button" data-action="create-character-essences">Create Essences and 20 Ability Slots</button>{{#if isGM}}<div class="system-panel"><h3>Add a Custom Essence</h3><label>Name <input data-catalog-field="name"/></label><label>Rarity <select data-catalog-field="rarity"><option value="common">Common</option><option value="uncommon">Uncommon</option><option value="rare">Rare</option><option value="epic">Epic</option><option value="legendary">Legendary</option><option value="unknown">Unknown</option></select></label><label>Description <input data-catalog-field="description"/></label><button type="button" data-action="add-custom-essence">Add to World Catalog</button></div>{{/if}}</div>{{/unless}}{{#each essenceGroups as |g|}}<div class="system-panel"><h3>{{titlecase g.key}} — {{g.essenceName}}</h3>{{#if g.essenceId}}<label>Bond <select data-action="bond-essence" data-id="{{g.essenceId}}">{{#each g.bondOptions as |o|}}<option value="{{o.value}}" {{#if o.selected}}selected{{/if}}>{{titlecase o.label}}</option>{{/each}}</select></label><label>Essence name <input data-action="rename-essence" data-id="{{g.essenceId}}" value="{{g.essenceName}}"/></label>{{/if}}{{#each g.abilities as |a|}}<div class="system-panel" data-editor-id="{{a.id}}"><div class="list-row"><label>Name <input data-edit-field="name" value="{{a.name}}"/></label><strong>{{titlecase a.rank}} {{a.level}}</strong></div><label>Action Cost <input type="number" min="0" data-edit-field="actionCost" value="{{a.actionCost}}"/></label><label>Mana Cost <input type="number" min="0" data-edit-field="manaCost" value="{{a.manaCost}}"/></label><label>Stamina Cost <input type="number" min="0" data-edit-field="staminaCost" value="{{a.staminaCost}}"/></label><label>Awakening Stone <input data-edit-field="awakeningStone" list="hwfwm-stone-list" value="{{a.awakeningStone}}" placeholder="Select or GM-approved custom"/></label><label>Favorite <input type="checkbox" data-edit-field="favorite" {{#if a.favorite}}checked{{/if}}/></label><button type="button" data-action="save-ability" data-id="{{a.id}}">Save Ability</button><button type="button" data-action="advance-ability" data-id="{{a.id}}">Advance ({{a.cost}} XP)</button></div>{{else}}<p>No linked abilities; each bonded essence needs five.</p>{{/each}}</div>{{/each}}{{else}}<p>Non-essence actor. Monster and familiar abilities are developed separately.</p>{{/if}}</div></div>
<div class="tab" data-group="primary" data-tab="skills"><div class="system-panel"><h2>Skills</h2>{{#each skillItems as |s|}}<div class="list-row">{{s.name}}</div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="talents"><div class="system-panel"><h2>Talents</h2><p>Talent XP: {{system.talentXP}}</p>{{#each talentItems as |t|}}<p>{{t.name}}</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="equipment"><div class="system-panel"><h2>Equipment</h2>{{#each equipmentItems as |it|}}<div class="list-row">{{it.name}} — {{it.system.slot}}</div>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="progression"><div class="system-panel"><h2>Advancement</h2><label>Essence XP <input type="number" name="system.essenceXP" value="{{system.essenceXP}}"/></label><label>Talent XP <input type="number" name="system.talentXP" value="{{system.talentXP}}"/></label>{{#if isGM}}<div class="system-panel"><h3>GM XP Awards</h3><label>Amount <input data-award-amount type="number" min="1" value="5"/></label><label>Reason <input data-award-reason value="Story milestone"/></label><button type="button" data-action="award-xp" data-currency="essenceXP">Award Essence XP</button><button type="button" data-action="award-xp" data-currency="talentXP">Award Talent XP</button></div>{{/if}}<div class="system-panel"><h3>Advancement Ledger</h3>{{#each ledger as |event|}}<p>{{event.kind}}: {{event.currency}} {{event.amount}} {{event.reason}} {{event.from}} {{event.to}} {{event.rankFrom}} {{event.rankTo}}</p>{{else}}<p>No advancement transactions recorded.</p>{{/each}}</div><div class="system-panel"><h3>Recent Awards</h3>{{#each recentXP as |entry|}}<p>{{entry.currency}} +{{entry.amount}} — {{entry.reason}}</p>{{else}}<p>No awards recorded.</p>{{/each}}</div><p>Rank is determined by the lowest of your four attributes; each attribute follows the lowest of its five essence abilities.</p>{{#each attributes as |a|}}<p>{{titlecase a.key}} — {{titlecase a.rank}} {{a.level}}</p>{{/each}}</div></div>
<div class="tab" data-group="primary" data-tab="biography"><div class="system-panel"><h2>Biography</h2></div></div>
</section></form>